{
  "uid": "estate-overview",
  "title": "Estate overview",
  "tags": [
    "gitops",
    "flux",
    "estate"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "blue",
        "name": "Deploys",
        "expr": "max by (site, revision) (gotk_resource_info{customresource_kind=\"GitRepository\"}) unless max by (site, revision) (gotk_resource_info{customresource_kind=\"GitRepository\"} offset 5m)",
        "step": "1m",
        "titleFormat": "Deploy: {{site}}",
        "textFormat": "{{revision}}",
        "tagKeys": "site"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "default",
          "value": "default"
        },
        "hide": 0,
        "includeAll": false,
        "label": "datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "GitOps: what Flux has applied",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Flux objects not Ready",
      "description": "Flux objects (sources, Kustomizations, HelmReleases) whose Ready condition is not True. Anything here is what `flux get all` would show as failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (site) (gotk_resource_info{ready!=\"True\"}) or count by (site) (gotk_resource_info) * 0",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{site}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Kustomizations stuck on an old revision",
      "description": "Kustomizations whose last attempted revision differs from their last applied one: a commit was fetched but failed to apply.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (site) (gotk_resource_info{customresource_kind=\"Kustomization\"} unless on (site, name, revision) label_replace(gotk_resource_info{customresource_kind=\"Kustomization\"}, \"revision\", \"$1\", \"attempted_revision\", \"(.*)\")) or count by (site) (gotk_resource_info) * 0",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{site}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "id": 4,
      "title": "Source revision per site",
      "description": "The commit each site's GitRepository has fetched. Akron tracks main, Eastbank tracks stable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotk_resource_info{customresource_kind=\"GitRepository\"}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "site",
                "name",
                "revision",
                "ready"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "site": 0,
              "name": 1,
              "revision": 2,
              "ready": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "site"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ready"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "color": "green",
                        "index": 0
                      },
                      "False": {
                        "color": "red",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Flux objects not Ready over time",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Deploys appear as annotations: a new GitRepository revision at a site.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (site) (gotk_resource_info{ready!=\"True\"}) or count by (site) (gotk_resource_info) * 0",
          "refId": "A",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "{{site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "table",
      "id": 6,
      "title": "Kustomizations",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotk_resource_info{customresource_kind=\"Kustomization\"}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "site",
                "name",
                "revision",
                "attempted_revision",
                "ready",
                "suspended"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "site": 0,
              "name": 1,
              "revision": 2,
              "attempted_revision": 3,
              "ready": 4,
              "suspended": 5
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "site"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ready"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "color": "green",
                        "index": 0
                      },
                      "False": {
                        "color": "red",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "id": 7,
      "title": "HelmReleases",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gotk_resource_info{customresource_kind=\"HelmRelease\"}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "site",
                "exported_namespace",
                "name",
                "chart_name",
                "revision",
                "chart_app_version",
                "ready",
                "suspended"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "site": 0,
              "exported_namespace": 1,
              "name": 2,
              "chart_name": 3,
              "revision": 4,
              "chart_app_version": 5,
              "ready": 6,
              "suspended": 7
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "site"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ready"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "color": "green",
                        "index": 0
                      },
                      "False": {
                        "color": "red",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "id": 8,
      "title": "Workloads: what is actually running",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 9,
      "title": "Pods not running",
      "description": "Pods in Pending, Failed or Unknown phase.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (site) (kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"} == 1) or count by (site) (kube_node_info) * 0",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{site}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 10,
      "title": "Container restarts (24h)",
      "description": "Includes restarts from node reboots, which restart every container at once.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (site) (round(increase(kube_pod_container_status_restarts_total[24h])))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{site}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "id": 11,
      "title": "Restarted containers (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (site, namespace, pod, container) (round(increase(kube_pod_container_status_restarts_total[24h]))) > 0",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "site",
                "namespace",
                "pod",
                "container",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "site": 0,
              "namespace": 1,
              "pod": 2,
              "container": 3,
              "Value": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "site"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ready"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "color": "green",
                        "index": 0
                      },
                      "False": {
                        "color": "red",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "id": 12,
      "title": "Running images",
      "description": "image_spec is what the manifest asked for; image_id is the digest actually pulled.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_pod_container_info",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "site",
                "namespace",
                "pod",
                "container",
                "image_spec",
                "image_id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "site": 0,
              "namespace": 1,
              "pod": 2,
              "container": 3,
              "image_spec": 4,
              "image_id": 5
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "site"
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ready"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "color": "green",
                        "index": 0
                      },
                      "False": {
                        "color": "red",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
