// The node log reader only reads; it forwards everything to the collector at
// this site over the in-cluster Loki push API (ADR 0003, *Behind the
// contract, two processes*). The collector stamps the site, applies the drops
// and holds the WAL, so every log passes one set of relabels and one buffer.
// The collector keeps the timestamps sent here (use_incoming_timestamp on its
// loki.source.api), which matters at startup: this reader keeps no positions,
// so it replays recent journal entries.
loki.write "default" {
  endpoint {
    url = "http://collector.monitoring:3100/loki/api/v1/push"
  }
}

// Only this node's pods. Every node runs a reader, so without the selector
// each one would ship every pod's logs on a site with a second node. The
// chart sets HOSTNAME to spec.nodeName.
discovery.kubernetes "pods" {
  role = "pod"

  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("HOSTNAME")
  }
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  // The Kubernetes node, not the machine: see `node` and `host` in the
  // naming convention.
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.pod_logs.receiver]
}

// Kubelet probe traffic, dropped on the way to Loki and nowhere else.
//
// The landing page serves an access log line per request, and almost every
// request is a probe: readiness every 10s plus liveness every 30s is ~8 lines
// a minute, ~11.5k a day, for a page opened about weekly. In the two hours
// after it first deployed, 26 of 30 sampled lines were `GET /healthz`.
//
// Dropped here rather than silenced in base/landing/app.py deliberately. The
// container log is the diagnostic surface — `kubectl logs` during an incident
// wants to see that the probes were arriving and being answered, which is
// often the thing that distinguishes "the pod is wedged" from "nothing is
// reaching it". This is a storage decision about what Loki keeps, not a
// decision about what the program says.
//
// Scoped to app="landing" rather than written as a general health-check rule:
// this is the one workload measured to have the problem, and a repo-wide drop
// would silently swallow probe logs from a future app where they matter.
loki.process "pod_logs" {
  forward_to = [loki.write.default.receiver]

  // The stream's name (naming convention, *Streams*). Without it,
  // loki.source.kubernetes names the stream after its own component ID.
  stage.static_labels {
    values = { job = "pod-logs" }
  }

  stage.match {
    selector = "{app=\"landing\"}"

    stage.drop {
      expression          = "\"GET /healthz HTTP/[0-9.]+\" 200"
      drop_counter_reason = "landing_probe_noise"
    }
  }
}

discovery.relabel "journal" {
  targets = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }
}

loki.source.journal "system" {
  path          = "/run/log/journal"
  forward_to    = [loki.write.default.receiver]
  relabel_rules = discovery.relabel.journal.rules
  labels = {
    job = "systemd-journal",
  }
}
