// Ship everything collected below to Prometheus. Snappy-compressed
// protobuf batches: a site of this size is well under 1 kbit/s.
prometheus.remote_write "default" {
  // Changing this block orphans the WAL's backlog: the queue is keyed by a
  // hash of it. Follow docs/runbooks/forwarding-path-changes.md.
  endpoint {
    url = "${METRICS_INGEST_URL}"
  }

  // external_labels only fills a label the signal doesn't already carry; it
  // never overwrites one (measured locally on Alloy v1.21.0, #514). So this
  // is the fallback for everything this site collects, and a receiver that
  // stamps another site, such as a Lottage-only ingest point, keeps its value.
  // It does not stop a push sender choosing its own site: overwriting that
  // belongs at the push receiver (ADR 0003: set by the collector, never the
  // sender).
  external_labels = {
    site = "${SITE_NAME}",
  }

  // Implements ADR 0003's outage window: changing max_keepalive_time
  // changes what the system accepts as lost, so it is an ADR revision.
  // What makes a remote site survive an outage of the WAN or of Akron
  // (anything that stops delivery to Akron's ingest). Truncation only
  // discards samples below the lowest successfully-sent timestamp, so
  // unsent data is kept regardless of age until max_keepalive_time —
  // that value, not truncate_frequency, is the ceiling on outage
  // length. The chart default is 8h. Akron's Prometheus must accept
  // samples this old: see tsdb.outOfOrderTimeWindow in
  // sites/akron/monitoring/kube-prometheus-stack.yaml, kept in sync.
  //
  // No queue_config tuning against the drain spiral (#270), by decision:
  // one occurrence, whose evidence points at the receiver rather than this
  // WAL, isn't enough to tune on. Recovery is
  // docs/runbooks/forwarding-path-recovery.md; see #522.
  wal {
    truncate_frequency = "2h"
    max_keepalive_time = "24h"
  }
}

// ---------------------------------------------------------------
// The same idea for logs. This collector is the only process at a
// site that talks to Akron, for either signal: apps push here and
// this pushes onward, rather than every app dialling across the WAN
// on its own. Its sender is the node log reader (pod logs and the
// journal, at every site), over the collector Service. Unpoller
// pushes to a listener of its own, added by Eastbank
// (sites/eastbank/monitoring/unpoller/unpoller.alloy). Neither is
// published on the LAN (collector-ingressroute.yaml).
//
// loki.source.api serves Loki's own push API, so a sender needs no
// knowledge that Alloy is in the path — it is pointed at this
// Service instead of at Loki.
// ---------------------------------------------------------------
loki.source.api "push" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3100
  }

  // Keep the sender's timestamps. The default stamps each entry when it
  // arrives here, which would misdate the journal entries the node log
  // reader replays at startup and Unpoller's polled events.
  use_incoming_timestamp = true

  forward_to = [loki.relabel.push.receiver]
}

// ---------------------------------------------------------------
// OTLP over HTTP, for logs and metrics (ADR 0003, *The site
// collector*). Served at every site, because our own software pushes
// OTLP wherever it runs, and a mobile sender uses whichever site it is
// at. The cluster reaches it on the collector Service, and the LAN
// through Traefik (collector-ingressroute.yaml). Both get the same
// receivers.
//
// Metric names are translated here, not in Prometheus (ADR 0003,
// *Appendix: naming conventions*). `claude_code.token.usage` with unit
// `tokens` arrives as `claude_code_token_usage_tokens_total`, and
// service.name becomes `job`. The other resource attributes go only on
// `target_info` (measured on Alloy v1.21.0, #514). Everything here is
// generally available, so it adds nothing to --stability.level.
// ---------------------------------------------------------------
otelcol.receiver.otlp "push" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.exporter.prometheus.push.input]
    logs    = [otelcol.exporter.loki.push.input]
  }
}

otelcol.exporter.prometheus "push" {
  forward_to = [prometheus.relabel.push.receiver]
}

otelcol.exporter.loki "push" {
  forward_to = [loki.relabel.push.receiver]
}

// Every signal a sender pushes gets this site, whatever the sender
// set: the site comes from the ingest point, never from the sender
// (ADR 0003). external_labels on the writers can't do it, because it
// never overwrites a label (#514). A receiver that stamps another
// site, such as a Lottage-only ingest point (#515), must not route
// through these.
prometheus.relabel "push" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    target_label = "site"
    replacement  = "${SITE_NAME}"
  }
}

loki.relabel "push" {
  forward_to = [loki.write.default.receiver]

  rule {
    target_label = "site"
    replacement  = "${SITE_NAME}"
  }
}

loki.write "default" {
  // Assume changing this block orphans the WAL's backlog, like the metrics
  // endpoint above. Follow docs/runbooks/forwarding-path-changes.md.
  endpoint {
    url = "${LOGS_INGEST_URL}"
  }

  // Fills a missing site only; see the note on prometheus.remote_write above.
  external_labels = {
    site = "${SITE_NAME}",
  }

  // The reason for putting Alloy in this path at all. Unpoller's own
  // Loki client has no disk buffer and gives up after a short
  // backoff, so a WAN outage silently punches a hole in exactly the
  // logs you would want afterwards to answer "was this router
  // compromised, and when". max_segment_age is the ceiling on how
  // much outage this survives; the chart default is 1h, and 24h
  // matches the metrics WAL above (ADR 0003's outage window).
  //
  // NOTE: this wal block is *experimental* upstream, unlike
  // prometheus.remote_write's, which is stable. That one cannot stand
  // in: it buffers metric samples only, and this is the only disk
  // buffer Alloy has for log entries. It is one reason collector.yaml
  // runs the collector at --stability.level=experimental, without
  // which it does not load; base/unifi-syslog's raw format is the
  // other. A breaking change to it would fail the collector at every
  // site, so it is the first thing to check if an alloy chart bump
  // misbehaves. Deleting these lines is a complete rollback, at the
  // cost of the buffering.
  wal {
    enabled         = true
    max_segment_age = "24h"
  }
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.kubernetes "nodes" {
  role = "node"
}

discovery.kubernetes "endpoints" {
  role = "endpoints"
}

// ---------------------------------------------------------------
// Every pod's metrics, collected by default (ADR 0003). Every metric a
// target serves is kept; tuning is dropping what measurement shows isn't
// useful, each with a DROP tag, never listing what to keep.
//
// Finding the targets is a separate question, answered two ways:
//
// - By default, a container port whose name is one of the common
//   conventions: metrics, http-metrics, http-prom (Flux), metricshttps
//   (MetalLB, behind kube-rbac-proxy). That needs no per-workload setup.
// - A straggler, whose port is named anything else, is declared with
//   the prometheus.io/scrape, prometheus.io/port and optional
//   prometheus.io/path pod annotations.
//
// Don't widen the name list to catch a straggler: a looser pattern
// starts catching ports that aren't metrics. Add a name only when it is
// a convention many charts share. Anything kube-prometheus-stack's own
// ServiceMonitors already scrape at Akron (Grafana, Prometheus,
// Alertmanager, the operator) must not be annotated, or it is collected
// twice.
//
// job is the pod's app.kubernetes.io/name, else its `app` label, else
// the container name; instance is the pod name. The exceptions below
// keep the job and instance the dashboards already select on. Unpoller
// names its port `tcp`, so its site's own stanza is the only one that
// scrapes it (sites/eastbank/monitoring/unpoller/unpoller.alloy).
//
// Useful collector series: send lag (the query is in
// docs/runbooks/forwarding-path-recovery.md),
// prometheus_remote_storage_samples_failed_total and
// go_memstats_heap_inuse_bytes. samples_pending doesn't track the backlog
// (#522). The collector's failure hides every
// other signal, so it must not be the one component nobody watches.
// ---------------------------------------------------------------
discovery.relabel "named_metrics_ports" {
  targets = discovery.kubernetes.pods.targets

  // kube-state-metrics serves the cluster's object state on `http`, and
  // only its own telemetry on `metrics`. This regex is repeated in
  // annotated_metrics_ports, so no port is collected by both.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_port_name"]
    regex         = "kube-state-metrics;http|[^;]*;(metrics|http-metrics|http-prom|metricshttps)"
    action        = "keep"
  }
}

// shortcut: the annotated port must be declared in the pod spec, and is
// scraped over plain HTTP. Read prometheus.io/scheme, or rewrite
// __address__ from the annotation, when a straggler needs either.
discovery.relabel "annotated_metrics_ports" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_port_name"]
    regex         = "kube-state-metrics;http|[^;]*;(metrics|http-metrics|http-prom|metricshttps)"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }

  // One target per declared port, so keep only the annotated one.
  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_number"]
    target_label  = "__meta_kubernetes_pod_annotation_prometheus_io_port"
    action        = "keepequal"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
}

discovery.relabel "pod_metrics" {
  targets = array.concat(discovery.relabel.named_metrics_ports.output, discovery.relabel.annotated_metrics_ports.output)

  // A completed Job's pod keeps its ports but serves nothing.
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Succeeded|Failed"
    action        = "drop"
  }

  // Lowest precedence first: each later rule overwrites only if its
  // label is set.
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "(.+)"
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    regex         = "(.+)"
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "instance"
  }

  // Node name, not pod name, so the node-exporter-full dashboard keeps
  // working across pod restarts.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    regex         = "prometheus-node-exporter"
    target_label  = "job"
    replacement   = "node-exporter"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_node_name"]
    regex         = "prometheus-node-exporter;(.+)"
    target_label  = "instance"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_container_port_name"]
    regex         = "kube-state-metrics;http"
    target_label  = "instance"
    replacement   = "kube-state-metrics"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_app"]
    regex         = "dns;unbound"
    target_label  = "instance"
    replacement   = "unbound"
  }

  // cert-manager is three programs under one job. instance is the
  // component, because a pod name would make a restart look like a new
  // series (#323).
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    regex         = "cert-manager"
    target_label  = "job"
    replacement   = "cert-manager"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_app_kubernetes_io_component"]
    regex         = "cert-manager;(.+)"
    target_label  = "instance"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_port_name"]
    regex         = "metricshttps"
    target_label  = "__scheme__"
    replacement   = "https"
  }
}

// Split by scheme so the ServiceAccount token goes only to HTTPS
// endpoints that ask for it, never in plaintext to every pod.
discovery.relabel "pod_metrics_http" {
  targets = discovery.relabel.pod_metrics.output

  rule {
    source_labels = ["__scheme__"]
    regex         = "https"
    action        = "drop"
  }
}

discovery.relabel "pod_metrics_https" {
  targets = discovery.relabel.pod_metrics.output

  rule {
    source_labels = ["__scheme__"]
    regex         = "https"
    action        = "keep"
  }
}

prometheus.scrape "pods" {
  targets         = discovery.relabel.pod_metrics_http.output
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "60s"
}

// MetalLB's kube-rbac-proxy accepts the collector's token, and serves a
// self-signed certificate.
prometheus.scrape "pods_https" {
  targets           = discovery.relabel.pod_metrics_https.output
  forward_to        = [prometheus.remote_write.default.receiver]
  scrape_interval   = "60s"
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

  tls_config {
    insecure_skip_verify = true
  }
}

// ---------------------------------------------------------------
// Kubelet and cAdvisor. Scraped directly on :10250 with the
// ServiceAccount token; k3s serves a self-signed kubelet certificate,
// hence insecure_skip_verify.
// ---------------------------------------------------------------
discovery.relabel "kubelet" {
  targets = discovery.kubernetes.nodes.targets

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "instance"
  }

  // kube-prometheus-stack's built-in Kubernetes dashboards select on
  // job="kubelet" plus metrics_path, so both are reproduced here.
  rule {
    target_label = "metrics_path"
    replacement  = "/metrics"
  }
}

discovery.relabel "cadvisor" {
  targets = discovery.kubernetes.nodes.targets

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "instance"
  }

  rule {
    target_label = "metrics_path"
    replacement  = "/metrics/cadvisor"
  }
}

prometheus.scrape "kubelet" {
  targets           = discovery.relabel.kubelet.output
  forward_to        = [prometheus.relabel.drop_histogram_buckets.receiver]
  job_name          = "kubelet"
  scrape_interval   = "60s"
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

  tls_config {
    insecure_skip_verify = true
  }
}

prometheus.scrape "cadvisor" {
  targets           = discovery.relabel.cadvisor.output
  forward_to        = [prometheus.relabel.cadvisor.receiver]
  job_name          = "kubelet"
  metrics_path      = "/metrics/cadvisor"
  scrape_interval   = "60s"
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

  tls_config {
    insecure_skip_verify = true
  }
}

// Cardinality trimming, carried over from the relabelings Akron's
// kube-prometheus-stack used to have (#147). Those replaced the chart's
// defaults rather than extending them, so this is not upstream's set;
// each rule stands on its own reasoning. This is the only copy in the
// repo, which is the point of both sites sharing one collector.
//
// `id` (the cgroup path) is kept, and must not be dropped: it is the only
// label telling the non-pod cgroups apart (/, kubepods.slice and its QoS
// slices, system.slice/k3s.service). Without it they collapse into one
// series that rejects samples and corrupts every rate over it (#307).
// It costs nothing for pods, where it maps one-to-one to `name`.
// Anything summing a container_* metric must filter container!="" or a
// specific id, because / contains everything below it.
prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.default.receiver]

  // Metric families not referenced by any configured dashboard.
  rule {
    source_labels = ["__name__"]
    regex         = "container_(tasks_state|cpu_load_average_10s|memory_mapped_file)"
    action        = "drop"
  }

  // DROP(saves: ~155 series, measured: 2026-10-19): page faults per
  // container. Redundant with container_memory_workingset_refault_file_total,
  // which counts every evicted file page brought back, read or mapped,
  // while major faults count only mapped ones: they missed Pi-hole's weekly
  // SQLite thrash entirely (#380). Keep the refault series.
  rule {
    source_labels = ["__name__"]
    regex         = "container_memory_failures_total"
    action        = "drop"
  }

  rule {
    source_labels = ["__name__"]
    regex         = "container_(network_tcp_usage_total|network_udp_usage_total|blkio_device_usage_total)"
    action        = "drop"
  }

  rule {
    source_labels = ["__name__"]
    regex         = "container_(fs_io_current|fs_io_time_seconds_total|fs_io_time_weighted_seconds_total)"
    action        = "drop"
  }

  rule {
    source_labels = ["__name__"]
    regex         = "container_(fs_reads_merged_total|fs_sector_reads_total|fs_sector_writes_total)"
    action        = "drop"
  }

  rule {
    source_labels = ["__name__"]
    regex         = "container_fs_writes_merged_total"
    action        = "drop"
  }
}

// ---------------------------------------------------------------
// kube-apiserver
// ---------------------------------------------------------------
discovery.relabel "apiserver" {
  targets = discovery.kubernetes.endpoints.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_service_name", "__meta_kubernetes_endpoint_port_name"]
    regex         = "default;kubernetes;https"
    action        = "keep"
  }

  rule {
    target_label = "instance"
    replacement  = "kube-apiserver"
  }
}

prometheus.scrape "apiserver" {
  targets           = discovery.relabel.apiserver.output
  forward_to        = [prometheus.relabel.drop_histogram_buckets.receiver]
  job_name          = "apiserver"
  scrape_interval   = "60s"
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

  tls_config {
    ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    server_name = "kubernetes.default.svc"
  }
}

// Every histogram bucket from the kubelet and apiserver jobs, which between
// them are the overwhelming majority of this cluster's series. A histogram
// costs one series per bucket boundary per label combination, so a single
// family like apiserver_request_sli_duration_seconds_bucket is 36k series on
// its own — more than every non-Kubernetes exporter here combined.
//
// This replaces the curated name list from #147, which is the point rather
// than a detail. That list was accurate when written and then silently stopped
// covering things as upstream added metrics: apiserver_request_sli_duration
// arrived in k8s 1.29, apiserver_watch_list_duration and
// apiserver_watch_cache_read_wait later still, and k3s serves etcd_* and
// workqueue_* from the same endpoint. None were in the list, and together they
// are ~120k series. A name list has to be revisited on every k8s bump to keep
// working; a rule about the shape of the metric does not.
//
// _sum and _count survive, so rate() and average latency stay queryable.
// histogram_quantile does not work without buckets — that is the trade, and it
// is the right one here: nobody is debugging apiserver p99 on a single-node
// homelab, and the series are paid for continuously whether queried or not.
prometheus.relabel "drop_histogram_buckets" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = ".*_bucket"
    action        = "drop"
  }
}
