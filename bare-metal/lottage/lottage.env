# What Lottage is. The bare-metal equivalent of clusters/<site>/cluster-vars.yaml,
# and read the same way: deploy.sh loads clusters/common/network-vars.yaml first,
# then this file over the top, matching Flux's substituteFrom ordering.
#
# No secrets here — it is committed. The only secret Lottage holds is the
# Cloudflare API token in /etc/lottage/cloudflare.ini on the box itself.
SITE_NAME=lottage
SITE_DOMAIN=lottage.internal.zerpzorp.com

# The Pi's static LAN address. Also LOTTAGE_HOST_IP in
# clusters/common/network-vars.yaml, where the other two sites read it — the
# same duplication METALLB_TRAEFIK_IP has with AKRON_TRAEFIK_IP, and for the
# same reason: this one means "me", that one means "Lottage, as dialled from
# elsewhere".
LOTTAGE_HOST_IP=CHANGEME

# PiHole's conditional forwarding, composed into FTLCONF_dns_revServers exactly
# as at the other sites. SITE_DOMAIN must match the UniFi per-network "Domain
# Name" for Lottage or the gateway answers for a domain PiHole never asks about.
LAN_CIDR=CHANGEME
LAN_GATEWAY=CHANGEME

# Where deploy.sh pushes. An ssh alias in ~/.ssh/config, or user@host.
LOTTAGE_SSH=lottage
